APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

STT_PROVIDER=whisper
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

TTS_PROVIDER=piper
TTS_MODEL=
TTS_VOICE=

# Leave empty to disable request signing in development
REQUEST_SIGNING_SECRET=
REQUEST_TIMESTAMP_TOLERANCE=60

# Leave empty to use in-memory store
REDIS_URL=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

MAX_AUDIO_SIZE_MB=25
MAX_MESSAGES=50
MAX_MESSAGE_LENGTH=10000
MAX_CONVERSATION_LENGTH=50000

CORS_ORIGINS=
